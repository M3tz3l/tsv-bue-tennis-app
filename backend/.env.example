# Database Configuration (SQLite)
DATABASE_URL=sqlite://e2e_test.db

# Teable Configuration
TEABLE_TOKEN=your-teable-token-here
TEABLE_API_URL=https://your-teable-instance.com/api

# JWT Secret
JWT_SECRET=your-jwt-secret-key-here

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database IDs
MEMBERS_TABLE_ID=604783
WORK_HOURS_TABLE_ID=604785

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
# Envelope/header From address. Required.
EMAIL_FROM=no-reply@example.com
# Optional. Domain announced in the SMTP EHLO command; defaults to EMAIL_HOST.
# Set this explicitly when the relay host is not your own sending domain.
# EMAIL_HELO_DOMAIN=mail.example.com

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000
