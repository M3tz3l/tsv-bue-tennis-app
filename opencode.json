{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GH_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-sqlite", "--db", "backend/tennis_app.db"]
    },
    "teable": {
      "type": "local",
      "command": ["npx", "-y", "teable-mcp"],
      "env": {
        "TEABLE_API_KEY": "{env:TEABLE_TOKEN}",
        "TEABLE_BASE_URL": "{env:TEABLE_API_URL}"
      }
    }
  }
}
