# Root env file loaded by compose.yaml (env_file). Copy to .env and fill in.
# .env is gitignored — never commit real credentials.

# Database Configuration (SQLite - much simpler!)
DATABASE_URL=sqlite:///app/data/auth.db

# Teable Configuration
TEABLE_API_URL=https://your-teable-instance.example/api
TEABLE_TOKEN=your-teable-token
TEABLE_BASE_ID=your-base-id

# JWT Secret
JWT_SECRET=generate-a-long-random-hex-string

# Table IDs (replace with your Teable table IDs)
MEMBERS_TABLE_ID=your-members-table-id
WORK_HOURS_TABLE_ID=your-work-hours-table-id

# Email Configuration (authenticated SMTP relay)
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USER=your-smtp-user
EMAIL_PASSWORD=your-smtp-password
# Envelope/header From address. Required — the app refuses to start without it.
EMAIL_FROM=no-reply@example.com
# Optional. Domain announced in the SMTP EHLO command; defaults to EMAIL_HOST.
# EMAIL_HELO_DOMAIN=mail.example.com

# Frontend URL for password reset links
FRONTEND_URL=https://example.com
