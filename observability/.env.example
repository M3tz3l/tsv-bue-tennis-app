# Copy this file to `.env` and set a strong password before starting the stack.
# The deploy workflow generates `.env` with a random password on its first run.

GRAFANA_HOST=grafana.tsv-bue-tennis.de
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# How long Loki keeps logs (720h = 30 days).
LOKI_RETENTION=720h
