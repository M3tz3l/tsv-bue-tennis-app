{
	"name": "TSV Tennis Dev",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined"
	],
	"mounts": [
		// Caches your compiled targets locally so they survive container rebuilds
		"source=${localWorkspaceFolder}/.cargo-target,target=${containerWorkspaceFolder}/target,type=bind",
		// Caches downloaded crates so you never download them twice
		"source=isolated-cargo-cache,target=/home/vscode/.cargo/registry,type=volume",
		// Persists MiMo Code session memory and global state across rebuilds
		"source=mimocode-data,target=/home/vscode/.local/share/mimocode,type=volume",
		// Persists GitHub CLI authentication and config
		"source=gh-cli-config,target=/home/vscode/.config/gh,type=volume"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"lldb.executable": "/usr/bin/lldb",
				"rust-analyzer.checkOnSave.command": "clippy",
				"files.watcherExclude": {
					"**/target/**": true,
					"**/node_modules/**": true
				}
			},
			"extensions": [
				"vadimcn.vscode-lldb",
				"mutantdino.resourcemonitor",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"serayuzgur.crates",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss"
			]
		}
	},
	"remoteEnv": {
		"DATABASE_URL": "sqlite:tennis_app.db",
		"OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
	},
	"forwardPorts": [
		5000,
		5173
	],
	"postCreateCommand": "mkdir -p /home/vscode/.local/state /home/vscode/.local/share/mimocode/log /home/vscode/.config/gh && chown -R vscode:vscode /home/vscode/.local /home/vscode/.config/gh && cd tsv-tennis-app && npm install",
	"remoteUser": "vscode"
}