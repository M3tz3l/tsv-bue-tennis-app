{
	"name": "TSV Tennis Dev",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined",
		"--env-file",
		".devcontainer/.env"
	],
	"mounts": [
		// Caches your compiled targets locally so they survive container rebuilds
		"source=tsv-tennis-target,target=${containerWorkspaceFolder}/target,type=volume",
		// Caches downloaded crates so you never download them twice
		"source=isolated-cargo-cache,target=/home/vscode/.cargo/registry,type=volume",
		// Persists MiMo Code session memory and global state across rebuilds
		"source=mimocode-data,target=/home/vscode/.local/share/mimocode,type=volume",
		// Persists GitHub CLI authentication and config
		"source=gh-cli-config,target=/home/vscode/.config/gh,type=volume"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"lldb.executable": "/usr/bin/lldb",
				"rust-analyzer.checkOnSave.command": "clippy",
				"files.watcherExclude": {
					"**/target/**": true,
					"**/node_modules/**": true
				}
			},
			"extensions": [
				"vadimcn.vscode-lldb",
				"mutantdino.resourcemonitor",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"serayuzgur.crates",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"saoudrizwan.claude-dev"
			]
		}
	},
	"remoteEnv": {
		"DATABASE_URL": "sqlite:tennis_app.db"
	},
	"forwardPorts": [
		5000,
		5173
	],
	"postCreateCommand": "sudo mkdir -p /home/vscode/.local/state /home/vscode/.local/share/mimocode/log /home/vscode/.config/gh && sudo chown -R vscode:vscode /home/vscode/.local /home/vscode/.config/gh && cd tsv-tennis-app && npm install",
	"remoteUser": "vscode"
}
